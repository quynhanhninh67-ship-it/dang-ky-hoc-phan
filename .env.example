# Cấu hình kết nối MySQL (đổi sang giá trị thực ở file .env cục bộ, không commit .env)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dang_ky_hoc_phan

# Tài khoản ứng dụng Java (đọc/ghi nghiệp vụ)
DB_APP_USER=app_rw
DB_APP_PASSWORD=change_me_app_password

# Tài khoản chạy migration / khởi tạo schema
DB_MIGRATOR_USER=db_migrator
DB_MIGRATOR_PASSWORD=change_me_migrator_password

# Tài khoản chỉ đọc báo cáo
DB_REPORTING_USER=reporting_ro
DB_REPORTING_PASSWORD=change_me_reporting_password

# Tài khoản root phục vụ môi trường dev/docker cục bộ
MYSQL_ROOT_PASSWORD=change_me_root_password
